# ---------------------------------------------------------------------------
# Example environment configuration.
# Copy this file to `.env` and adjust as needed:  cp .env.example .env
# All values below are the defaults baked into order_pipeline/config.py, so an
# empty .env will work out of the box against the bundled docker-compose stack.
# ---------------------------------------------------------------------------

# --- Connectivity ---
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
SCHEMA_REGISTRY_URL=http://localhost:8081

# --- Topics ---
ORDERS_TOPIC=orders
DLQ_TOPIC=orders.DLQ
TOPIC_PARTITIONS=3
TOPIC_REPLICATION_FACTOR=1

# --- Consumer ---
CONSUMER_GROUP=order-processors

# --- Retry policy (transient failures) ---
MAX_RETRIES=3
RETRY_BASE_DELAY=0.5
RETRY_BACKOFF_FACTOR=2.0
RETRY_MAX_DELAY=8.0
RETRY_JITTER=0.3

# --- Failure injection (for demonstrating retry + DLQ) ---
# Probability that processing a message fails *transiently* on any given attempt.
TRANSIENT_FAILURE_RATE=0.15
# Business rule: orders outside [0, MAX_PRICE] are treated as permanent (invalid)
# failures and routed straight to the DLQ without retries.
MAX_PRICE=10000.0
